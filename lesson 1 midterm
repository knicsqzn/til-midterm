def animate(index=0):
    global after_id
    if index >= len(target):
        welcome_label.config(text=target)
        after_id = root.after(300, enable_key_close)
        return

    if target[index] == " ":
        current[index] = " "
        animate(index + 1)
    else:
        letter = random.choice(letters)
        current[index] = letter
        welcome_label.config(text="".join(current))

        if letter == target[index]:
            after_id = root.after(3, animate, index + 1)
        else:
            after_id = root.after(3, animate, index)

